# syntax=docker/dockerfile:1
# Derived Open WebUI image: the pinned upstream release plus the ronzz
# "artifact pipeline" patches.
#
# The patches (see the source branch commits and the ADR
# `docs/decisions/owui-artifact-pipeline.md` in ronzz-wikibase):
#   A. the code interpreter persists every base64 image format, not just PNG;
#   B. the execute_code result exposes the uploaded file record (id, url, name,
#      path) so a downstream tool can reference the stored file;
#   C. only raster image formats every vision endpoint accepts are sent to the
#      model as image inputs (an SVG tool result used to reach DeepSeek as
#      `data:image/svg+xml` and fail with HTTP 400);
#   D. the tool-call UI surfaces staged files and their server paths;
#   E. execute_code accepts files_to_save and stages interpreter files;
#   F. a model may scope its tool-server tools with meta.toolFilter.
#
# D and E live in the Svelte frontend, so the image builds the frontend from
# this source tree as well as overlaying the patched backend modules.

######## Frontend ########
FROM --platform=$BUILDPLATFORM node:22-alpine3.20 AS frontend

WORKDIR /app

RUN apk add --no-cache git

COPY package.json package-lock.json ./
RUN npm ci --force

COPY . .
# Vite's production build needs more than node's default heap on arm64.
ENV NODE_OPTIONS=--max-old-space-size=8192
RUN npm run build

######## Runtime ########
FROM ghcr.io/open-webui/open-webui:v0.12.0

# The staged-files UI and the files_to_save -> saved_files bridge are frontend
# changes; without this copy the backend contract would have no client support.
COPY --from=frontend /app/build /app/build

COPY backend/open_webui/utils/files.py /app/backend/open_webui/utils/files.py
COPY backend/open_webui/utils/code_interpreter.py /app/backend/open_webui/utils/code_interpreter.py
COPY backend/open_webui/utils/kernel_pool.py /app/backend/open_webui/utils/kernel_pool.py
COPY backend/open_webui/utils/interpreter_attachments.py /app/backend/open_webui/utils/interpreter_attachments.py
COPY backend/open_webui/utils/tool_filter.py /app/backend/open_webui/utils/tool_filter.py
COPY backend/open_webui/utils/middleware.py /app/backend/open_webui/utils/middleware.py
COPY backend/open_webui/utils/misc.py /app/backend/open_webui/utils/misc.py
COPY backend/open_webui/tools/builtin.py /app/backend/open_webui/tools/builtin.py

# Drop bytecode cached in the base image for the replaced modules, so Python
# recompiles them instead of importing a stale .pyc that predates the patch.
RUN rm -f \
      /app/backend/open_webui/utils/__pycache__/files.*.pyc \
      /app/backend/open_webui/utils/__pycache__/code_interpreter.*.pyc \
      /app/backend/open_webui/utils/__pycache__/kernel_pool.*.pyc \
      /app/backend/open_webui/utils/__pycache__/interpreter_attachments.*.pyc \
      /app/backend/open_webui/utils/__pycache__/middleware.*.pyc \
      /app/backend/open_webui/utils/__pycache__/misc.*.pyc \
      /app/backend/open_webui/tools/__pycache__/builtin.*.pyc
